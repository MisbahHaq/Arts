<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BulkyWeb</title>

    <link rel="stylesheet" href="~/css/output.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-white overflow-x-hidden">

    <!-- ================= NAVBAR ================= -->
    <style>
        .nb-inner {
            display: flex;
            align-items: center;
            width: 100%;
            height: 80px;
            padding: 0 24px;
        }
        .nb-left  { flex: 1; display: flex; align-items: center; gap: 20px; }
        .nb-center { flex: 0 0 auto; font-weight: 700; letter-spacing: 6px; font-size: 18px; }
        .nb-right { flex: 1; display: flex; align-items: center; justify-content: flex-end; gap: 20px; }
    </style>

    <nav class="fixed top-0 left-0 w-full h-20 z-[60] transition-all duration-300 bg-transparent text-black">

        <div class="nb-inner">

            <!-- LEFT (links) -->
            <div class="nb-left">
                @* <a href="/shop" class="hover:opacity-70">Shop</a> *@
            </div>

            <!-- CENTER LOGO -->
            <div class="nb-center">
                REPRESENT
            </div>

            <!-- RIGHT (icons) -->
            <div class="nb-right">

                <a href="/retail" class="hidden xl:block hover:opacity-70">Retail</a>
                <a href="/vault" class="hidden xl:block hover:opacity-70">Vault</a>
                <a href="/prestige" class="hidden xl:block hover:opacity-70">Prestige</a>

                <i class="fa-solid fa-magnifying-glass cursor-pointer"></i>
                <i class="fa-regular fa-bookmark cursor-pointer"></i>
                <i class="fa-regular fa-user cursor-pointer"></i>
                <i class="fa-solid fa-bag-shopping cursor-pointer"></i>

                <button id="mobileMenuBtn" class="lg:hidden text-xl ml-2">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- ================= MOBILE MENU ================= -->
    @* <div id="mobileMenu" class="fixed top-0 left-0 w-[300px] h-screen bg-white text-black z-[100]
        transform -translate-x-full transition-transform duration-300 shadow-2xl">

        <div class="p-6 flex flex-col h-full">

            <button id="closeMenu" class="text-2xl mb-8 self-end">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <ul class="space-y-6 text-lg">
                <li><a href="/shop">Shop</a></li>
                <li><a href="/summer">Summer</a></li>
                <li><a href="/look">Lookbooks</a></li>
                <li><a href="/cart">Cart</a></li>
                <li><a href="/auth">Account</a></li>
            </ul>

        </div>
    </div> *@

    <!-- ================= MAIN ================= -->
    <main class="pt-20">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="border-t py-6 text-center text-gray-500 text-sm">
        <p>&copy; 2026 - BulkyWeb</p>
    </footer>

    <!-- ================= SCRIPT ================= -->
    <script>
            const mobileMenu = document.getElementById("mobileMenu");
            const openBtn = document.getElementById("mobileMenuBtn");
            const closeBtn = document.getElementById("closeMenu");

            openBtn.addEventListener("click", () => {
                mobileMenu.style.transform = "translateX(0)";
            });

            closeBtn.addEventListener("click", () => {
                mobileMenu.style.transform = "translateX(-100%)";
            });
    </script>
</body>

</html>